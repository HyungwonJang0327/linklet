{
  "name": "linklet-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:baseline": "BASELINE=1 playwright test --project=baseline",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:down:clean": "docker compose down -v",
    "db:test:up": "docker compose up -d --wait db-test",
    "db:test:down": "docker compose rm -sfv db-test",
    "db:generate": "prisma generate",
    "baseline:up": "bash e2e/baseline/run-baseline.sh",
    "baseline:seed": "bash e2e/baseline/seed-baseline.sh",
    "baseline:down": "bash e2e/baseline/stop-baseline.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  }
}
