# 키 이름만 둔다. 값은 절대 커밋하지 않는다 (리포 PUBLIC).
# 부팅 시 검증 스키마: src/shared/config/env.ts (서버, 전체 키) · env.client.ts (브라우저, NEXT_PUBLIC_* 만).
#   이 파일의 키 목록과 env.ts 의 SERVER_ENV_KEYS 는 같아야 한다 (env.test.ts 가 확인).
# 클라이언트에 노출되는 값만 NEXT_PUBLIC_ 접두사를 붙인다.
# 비워 둔 키(`KEY=`)는 미설정으로 본다. [필수(Phase 1)] 가 비어 있으면 서버가 부팅하지 않는다.
# [이식 시 필수] 는 해당 FEATURES 행을 이식할 때 env.ts 에서 optional 을 벗긴다.
# NODE_ENV 는 Next 가 설정하므로(dev=development, 그 외=production) 여기 적지 않는다.

# 앱 — [필수(Phase 1)] http(s) URL. 자기 호출·공유 링크의 절대 URL 기준. 로컬 포트 하드코딩 금지
NEXT_PUBLIC_APP_URL=

# DB (Neon) — [필수(Phase 1)] postgresql:// 접속 문자열. 런타임은 pooled, Prisma CLI는 unpooled. 로컬은 Docker Postgres
# 로컬(pnpm db:up, 접속 정보는 docker-compose.yml 의 더미 고정값):
#   DATABASE_URL=postgresql://linklet:linklet@127.0.0.1:5433/linklet_dev
#   DATABASE_URL_UNPOOLED 도 같은 값 — 로컬은 풀링 구분이 없다. 테스트 DB 는 5434/linklet_test
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 인증 (Better Auth + Google OAuth) — [이식 시 필수: F08]
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 이미지 저장소 (Cloudflare R2, S3 호환) — [이식 시 필수: F20]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# 에러 모니터링 (Sentry) — [이식 시 필수: F06]
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# 분석 (공유 페이지 GA) — [선택: F26, 운영에서만]
NEXT_PUBLIC_GA_MEASUREMENT_ID=
