# 키 이름만 둔다. 값은 절대 커밋하지 않는다 (리포 PUBLIC).
# 부팅 시 검증 스키마는 src/shared/config/env.ts (로드맵 Phase 1)에서 확정하며, 그때 이 목록을 맞춘다.
# 클라이언트에 노출되는 값만 NEXT_PUBLIC_ 접두사를 붙인다.

# 앱
NEXT_PUBLIC_APP_URL=

# DB (Neon) — 런타임은 pooled, Prisma CLI는 unpooled. 로컬은 Docker Postgres
# 로컬(pnpm db:up, 접속 정보는 docker-compose.yml 의 더미 고정값):
#   DATABASE_URL=postgresql://linklet:linklet@127.0.0.1:5433/linklet_dev
#   DATABASE_URL_UNPOOLED 도 같은 값 — 로컬은 풀링 구분이 없다. 테스트 DB 는 5434/linklet_test
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 인증 (Better Auth + Google OAuth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 이미지 저장소 (Cloudflare R2, S3 호환)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# 에러 모니터링 (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# 분석 (공유 페이지)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
