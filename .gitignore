# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 로컬 도구 설정 (개인·시크릿 포함 가능)
.mcp.json
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (all except .env.example) — 시크릿은 git에 올리지 않는다
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# 리뉴얼 감사 스크린샷: 테스트 데이터(토큰·이메일 노출 가능) 포함, 전후 비교 후 삭제
/audit/screenshots/
